# ════════════════════════════════════════════════════════════════════════════
# Auto News Video — Environment Configuration
# ════════════════════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in your real API keys.
# .env.local is gitignored — never commit real keys.

# ── TTS Provider ────────────────────────────────────────────────────────────
# Choose ONE: "lucylab" or "elevenlabs"
# - lucylab    : Vietnamese voice cloning (recommended for VN content), free SRT
# - elevenlabs : multilingual, more voice options, higher quality but pricier
TTS_PROVIDER=lucylab

# ════════════════════════════════════════════════════════════════════════════
# OPTION 1: LucyLab.io  (https://lucylab.io)
# ════════════════════════════════════════════════════════════════════════════
# Required when TTS_PROVIDER=lucylab
VIETNAMESE_API_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
VIETNAMESE_VOICEID=22charvoiceiduuidhere

# Optional overrides
LUCYLAB_ENDPOINT=https://api.lucylab.io/json-rpc
LUCYLAB_POLL_INTERVAL_MS=2000
LUCYLAB_POLL_TIMEOUT_MS=120000

# ════════════════════════════════════════════════════════════════════════════
# OPTION 2: ElevenLabs  (https://elevenlabs.io)
# ════════════════════════════════════════════════════════════════════════════
# Required when TTS_PROVIDER=elevenlabs
# Get API key at:  https://elevenlabs.io/app/settings/api-keys
# Browse voices at: https://elevenlabs.io/app/voice-library
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Optional model override (default: eleven_multilingual_v2 — supports Vietnamese)
# Other options: eleven_turbo_v2_5 (fastest), eleven_multilingual_v2 (best quality)
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_ENDPOINT=https://api.elevenlabs.io/v1

# ════════════════════════════════════════════════════════════════════════════
# TikTok follow card (outro)
# ════════════════════════════════════════════════════════════════════════════
# Customize the TikTok-style profile card that appears at the end of every video.
# All fields optional — defaults work out of the box.
TIKTOK_DISPLAY_NAME=Quẹp Làm IT
TIKTOK_HANDLE=@haiquep
TIKTOK_FOLLOWERS=11.5k followers

# Optional: URL to your real TikTok avatar image (jpg/png, square, ~256x256+).
# If not set, uses the bundled default avatar at assets/avatar.jpg.
# You can also replace assets/avatar.jpg directly with your own image.
# TIKTOK_AVATAR_URL=https://example.com/your-avatar.jpg

# ── Pipeline tuning ─────────────────────────────────────────────────────────
# TTS_CONCURRENCY: 1 for LucyLab (API limit), can increase for ElevenLabs
TTS_CONCURRENCY=1

# ════════════════════════════════════════════════════════════════════════════
# Background music bed (assets/music — see assets/music/README.md)
# ════════════════════════════════════════════════════════════════════════════
# Drop royalty-free tracks into assets/music/. The pipeline loops one track
# under the voice with automatic ducking (music dips while the voice speaks).
# MUSIC_ENABLED=0        # disable globally (default: enabled)
# MUSIC_VOLUME=0.16      # bed volume 0-1 before ducking (default 0.16)
# MUSIC_FILE=/absolute/path/to/track.mp3   # force one specific file


# ─────────────────────────────────────────────────────────────
# XUẤT VIDEO — chuẩn TikTok dọc (1080×1920, H.264, MP4)
# ─────────────────────────────────────────────────────────────
# Độ phân giải 1080×1920 đã cố định trong composition (data-width/data-height
# + styles.css), không đổi ở đây. Các biến dưới điều khiển encoder.

# Frame rate: 24 | 30 | 60. 60 mượt hơn cho animation, render lâu ~2×.
VIDEO_FPS=60

# Preset x264: draft (ultrafast/CRF28) | standard (medium/CRF18) | high (slow/CRF15).
VIDEO_QUALITY=high

# Bitrate mục tiêu — cái quyết định video có bị mờ sau khi TikTok nén lại hay không.
# Khi có giá trị, encoder chạy ABR (-b:v) thay vì CRF.
#   10M = mức tối thiểu nên dùng   |  20M = nét nhất, file ~150 MB/60s
# Đặt VIDEO_BITRATE=off để quay về chế độ CRF của preset.
VIDEO_BITRATE=20M

# Override CRF trực tiếp (0–51, thấp = nét hơn). Nếu set thì VIDEO_BITRATE bị bỏ qua.
# VIDEO_CRF=15

# GPU encode (h264_videotoolbox trên macOS): nhanh hơn nhiều nhưng chất lượng/bit
# kém hơn libx264 ở cùng bitrate. Chỉ bật khi cần render gấp.
VIDEO_GPU=0

# Ngưỡng cảnh báo (Mbps) ở bước ffprobe verify sau khi render.
VIDEO_MIN_MBPS=10

# ─────────────────────────────────────────────────────────────
# VISUAL THEME + BRANDING (MAI Crypto / @oncoinx2 image-driven look)
# ─────────────────────────────────────────────────────────────
# maicrypto (default) = image-driven, minimal chrome, finance hook, sun brand.
# broadcast            = original neon text-card look (ticker + karaoke captions).
VIDEO_THEME=maicrypto
BRAND_NAME=MAI Crypto
BRAND_HANDLE=@maicrypto
# Logo file inside assets/ (the sun). jpg/png/webp/svg.
BRAND_LOGO_FILE=avatar.png
# Dynamic top-center credit prefix → "Tổng hợp bởi <source>".
BRAND_CREDIT_PREFIX=Tổng hợp bởi

# Per-scene AI image generation (free, no API key — Pollinations).
# Used when a scene provides image.prompt. Set to 0 to disable.
IMAGEGEN_ENABLED=1
# IMAGEGEN_ENDPOINT=https://image.pollinations.ai/prompt
# IMAGEGEN_STYLE=cinematic editorial news illustration, dramatic lighting, high detail, 9:16 vertical, realistic


# ─────────────────────────────────────────────────────────────
# REAL-PHOTO WEB SEARCH for scene images (preferred over AI gen)
# Each scene's image.query (or a query derived from image.prompt) is searched
# on the web and the first good match is downloaded. Tried in order; no key
# needed for duckduckgo/openverse/wikimedia. Add a free key for best quality.
# ─────────────────────────────────────────────────────────────
# IMAGE_SOURCE=duckduckgo,openverse,wikimedia   # override sources/order
# PEXELS_API_KEY=            # https://www.pexels.com/api/  (free, best quality)
# UNSPLASH_ACCESS_KEY=       # https://unsplash.com/developers  (free)

# ════════════════════════════════════════════════════════════════════════════
# SCENE VIDEO CLIPS (theme maicrypto) — "tich hop video"
# ════════════════════════════════════════════════════════════════════════════
# A scene can carry `video: { query: "..." }` (search related platforms/pages
# for a clip) or `video: { src: "..." }` (direct mp4 URL or local file).
# Every clip is normalised by ffmpeg to 1080x1920, muted, and trimmed/looped to
# the exact length of its beat, so the frame-by-frame renderer stays stable.
SCENE_VIDEO_ENABLED=1
# Search order. articles = open related web pages and pull og:video/<video>/.mp4
# SCENE_VIDEO_SOURCE=youtube,pexels,pixabay,wikimedia,articles
#
# ── youtube ─────────────────────────────────────────────────────────────────
# Tim clip ngan theo dung chu de cua script tren YouTube.
#
# QUAN TRONG: nguon nay CHI lay video co licence Creative Commons
# (videoLicense=creativeCommon) — tuc tac gia da chu dong cho phep tai su dung,
# ke ca muc dich thuong mai, VOI DIEU KIEN ghi nguon. Pipeline tu dien credit
# "YouTube - <ten kenh> (CC BY)"; ban PHAI de credit do hien tren video hoac
# trong phan mo ta khi dang. Bo credit di la vi pham licence.
#
# Hai luu y thuc te:
#   1. Kho CC-BY kha nho (vai % so video). Nhieu scene se khong tim ra clip ->
#      nen giu pexels/wikimedia phia sau lam du phong.
#   2. Tai file can `yt-dlp` (API cua YouTube chi tra metadata, khong tra mp4).
#      Cai: brew install yt-dlp
#   3. Quota mac dinh 10.000 don vi/ngay, moi luot search ton 100 -> ~100 luot
#      tim/ngay. Moi scene co video.query la mot luot.
#
# Lay key: console.cloud.google.com -> bat "YouTube Data API v3" -> tao API key
# YOUTUBE_API_KEY=
# Bo qua clip dai hon nguong nay (giay). Mac dinh 1200 (20 phut).
#
# Vi sao khong de thap: video CC-BY tren YouTube phan lon la long-form
# (10-30 phut). Dat 240 nhu ban dau thi loai gan het ket qua. Pipeline chi cat
# lay vai giay dau moi scene nen video nguon dai khong anh huong khung hinh —
# chi ton thoi gian tai. Da co --max-filesize 120M chan file qua nang.
#
# Ha xuong (vd 600) neu muon render nhanh hon va chap nhan it ket qua hon.
YOUTUBE_MAX_SEC=1200
# Doi duong dan neu yt-dlp khong nam trong PATH
# YTDLP_PATH=/opt/homebrew/bin/yt-dlp
#
# Optional free keys that unlock the stock-footage sources
# PEXELS_API_KEY=
# PIXABAY_API_KEY=
# Longest single clip to keep (seconds); longer beats loop the clip
SCENE_VIDEO_MAX_SEC=12

# ── Branding (theme maicrypto) ──────────────────────────────────────────────
BRAND_NAME=MAI CRYPTO
BRAND_HANDLE=@maicrypto.media
BRAND_LOGO_FILE=avatar.png
BRAND_CREDIT_PREFIX=Tổng hợp bởi
